rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || request.auth.token.email == 'purevs@gmail.com');
    }
    match /users/{userId}/cows/{cowId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId}/cows/{cowId}/milkYields/{yieldId} {
      allow read, write: if request.auth != null;
    }
  }
}
