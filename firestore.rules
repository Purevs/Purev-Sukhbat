rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId}/cows/{cowId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId}/cows/{cowId}/milkYields/{yieldId} {
      allow read, write: if request.auth != null;
    }
  }
}
